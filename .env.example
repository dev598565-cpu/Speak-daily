# SpeakDaily Environment Configuration
# Copy this file to .env and fill in your Supabase credentials

# Supabase Configuration (From your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Optional: Google Gemini API Key for deep AI feedback (if blank, built-in NLP engine is used)
VITE_GEMINI_API_KEY=
